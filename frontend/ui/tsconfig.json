{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "build/types",
		"tsBuildInfoFile": "build/.tsbuildinfo",
		"jsx": "react-jsx",
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"]
}
