CORE_ENVIRONMENT=development
CORE_PUBLIC_ORIGIN=http://localhost:4000
CORE_PASSWORD_PEPPER_SECRET_REF=env:CORE_PASSWORD_PEPPER
CORE_CSRF_SECRET_REF=env:CORE_CSRF_SECRET
CORE_DATA_ENCRYPTION_SECRET_REF=env:CORE_DATA_ENCRYPTION_SECRET
CORE_SECURITY_DIGEST_SECRET_REF=env:CORE_SECURITY_DIGEST_SECRET
CORE_OUTBOUND_HOSTS=
CORE_SESSION_TTL_MS=86400000
CORE_ADMIN_SESSION_TTL_MS=900000
CORE_LOGIN_ATTEMPT_LIMIT=10
CORE_LOGIN_ATTEMPT_WINDOW_MS=60000
CORE_SHUTDOWN_TIMEOUT_MS=10000
CORE_INSTALLATION_TOKEN_TTL_MS=86400000
CORE_INSTALLATION_TOKEN_FILE=runtime/installation-token
CORE_INSTANCE_PRIVATE_KEY_FILE=runtime/instance-identity/private-key.pem
CORE_PASSWORD_PEPPER=__GENERATE_32__
CORE_CSRF_SECRET=__GENERATE_32__
CORE_DATA_ENCRYPTION_SECRET=__GENERATE_32__
CORE_SECURITY_DIGEST_SECRET=__GENERATE_32__
